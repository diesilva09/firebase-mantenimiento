# =============================================================================
# ENTORNO DE DESARROLLO — copia este archivo a .env.development.local
# Comando: cp .env.development.local.example .env.development.local
#
# Next.js carga este archivo SOLO cuando ejecutas: npm run dev:local
# NO afecta producción (PM2 en puerto 3000).
# =============================================================================

# --- Base de datos (OBLIGATORIO: distinta a producción) ---
# Producción usa: area_mantenimiento
# Desarrollo debe usar: area_mantenimiento_dev
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/area_mantenimiento_dev

# Puerto del servidor de desarrollo (producción usa 3000)
PORT=3001

# --- Roles de prueba (correos de dev, no de usuarios reales) ---
NEXT_PUBLIC_ADMIN_EMAILS=dev-admin@tudominio.com
TECNICO_EMAILS=dev-tecnico@tudominio.com
INVITADO_EMAILS=dev-invitado@tudominio.com

# --- Google Drive: carpeta SEPARADA o dejar vacío para desactivar ---
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# --- Web Push: keys NUEVAS solo para dev (npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:dev@tudominio.com

PRISMA_ENABLED=true

# Opcional: marcar visualmente que estás en desarrollo
# NEXT_PUBLIC_APP_ENV=development
