# Copia este archivo a .env y rellena los valores antes de ejecutar migraciones
# Cadena de conexión PostgreSQL (ejemplo):
# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/maintenance_db

# (Opcional) Firebase Admin service account JSON (si vas a verificar tokens en el servidor)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"...","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"..."}

# Lista de emails admin para inicio rápido (será verificada en el servidor si lo implementas)
ADMIN_EMAILS=admin@demo.local,other@domain.local

# Google Drive API - Credenciales de cuenta de servicio
# Crear en: https://console.cloud.google.com/iam-admin/serviceaccounts
# Descargar el JSON de la cuenta de servicio y extraer:
GOOGLE_DRIVE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# ID de la carpeta raíz en Drive donde se crearán las carpetas de equipos (opcional)
# Si no se proporciona, se usará la carpeta raíz del drive
GOOGLE_DRIVE_FOLDER_ID=optional_root_folder_id

# Web Push puro - generar con: npx web-push generate-vapid-keys
# Clave publica para el navegador
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
# Clave privada para el backend (no exponer al cliente)
WEB_PUSH_PRIVATE_KEY=
# Subject recomendado: mailto:tu-correo@dominio.com
WEB_PUSH_SUBJECT=mailto:admin@demo.local
